# GitHub API access (optional but strongly recommended).
# Without a token, GitHub analysis falls back to unauthenticated requests,
# which have a much lower rate limit (60 requests/hour per IP).
GITHUB_TOKEN=

# Base URL for the OSV (Open Source Vulnerabilities) API.
# Used for dependency security advisory lookups. Defaults to the public
# OSV endpoint if not set.
OSV_API_URL=https://api.osv.dev/v1

# Optional: enables the AI Engineering Summary feature.
# If unset, GitPulse falls back to a deterministic, template-based summary
# and all scoring/analysis continues to work exactly the same.
AI_API_KEY=

# Optional: persistent database connection for scan history across restarts.
# If unset, GitPulse persists scans to a local JSON file under /data for
# development. Provide a Postgres connection string to enable durable,
# multi-instance storage in production (see README for migration notes).
DATABASE_URL=
