# ---------------------------------------------------------------------------
# REQUIRED: none. GitPulse works out of the box for public GitHub repos and
# package.json uploads with zero configuration.
# ---------------------------------------------------------------------------

# OPTIONAL — GitHub API access.
# Without a token, GitHub analysis still works for public repositories, but
# is limited to 60 unauthenticated requests/hour per IP, which is easy to
# exhaust in production. Create a token with no special scopes (public
# read-only) at https://github.com/settings/tokens and set it here to raise
# the limit to 5,000 requests/hour.
GITHUB_TOKEN=

# OPTIONAL — overrides the OSV (Open Source Vulnerabilities) API base URL.
# Defaults to the public endpoint if unset. Only change this if you're
# running a private OSV-compatible mirror.
OSV_API_URL=https://api.osv.dev/v1

# OPTIONAL — enables the AI Engineering Summary feature (an Anthropic API
# key). If unset, GitPulse falls back to a deterministic, template-based
# summary and every other feature works identically.
AI_API_KEY=

# NOT CURRENTLY USED — reserved for a future database-backed scan history.
# The core scan flow (analyze -> view dashboard -> view report) does NOT
# require a database: scan results are self-contained, URL-safe encoded
# tokens (see lib/scanEncoding.ts), so they work identically in local dev
# and on Vercel serverless with zero persistent storage. See README
# "Persistence" section before setting this.
DATABASE_URL=
